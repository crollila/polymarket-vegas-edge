# ---- Polymarket US (api.polymarket.us) ----
# Create these at https://polymarket.us -> Account -> API keys
PM_API_KEY_ID="00000000-0000-0000-0000-000000000000"
PM_PRIVATE_KEY_BASE64="base64-ed25519-private-key=="

# ---- The Odds API (https://the-odds-api.com) ----
# Free tier = 500 requests/month. Sign up and paste the real key here.
ODDS_API_KEY="your_theoddsapi_key"

# Comma-separated bookmaker keys. "fanduel" is the anchor you asked for.
# Add more (draftkings,betmgm,caesars,pinnacle) to use a consensus median instead.
ODDS_API_BOOKMAKERS="fanduel"

# us | us2 | uk | eu | au  (only used if ODDS_API_BOOKMAKERS is empty)
ODDS_API_REGION="us"
